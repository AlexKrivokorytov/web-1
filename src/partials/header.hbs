<header class="header">
    <h1 class="header__title">{{siteName}}</h1>
    <div class="header__controls">
        <nav class="navigation">
            <ul class="navigation__list">
                <li><a class="navigation__link{{#if activeHome}} navigation__link--active{{/if}}" href="index.html">Home</a></li>
                <li><a class="navigation__link{{#if activeAbout}} navigation__link--active{{/if}}" href="about.html">About</a></li>
                <li><a class="navigation__link{{#if activeContacts}} navigation__link--active{{/if}}" href="contacts.html">Contacts</a></li>
            </ul>
        </nav>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
            <svg class="h-5 w-5 dark:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
            </svg>
            <svg class="hidden h-5 w-5 dark:block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z"></path>
            </svg>
        </button>
    </div>
</header>
